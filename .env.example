# ==============================================================================
# Enterprise RAG Platform — Environment Variables Placeholder (.env.example)
# Guardrail #8: No secrets in Git. Use placeholder variable names only.
# ==============================================================================

# --- Application & Environment ---
ENVIRONMENT=development
APP_NAME=enterprise-rag-platform
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=replace-with-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL (Relational Source of Truth — Async Driver postgresql+asyncpg) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=rag_platform
DATABASE_URL=postgresql+asyncpg://rag_user:replace-with-postgres-password@postgres:5432/rag_platform

# --- Redis (Cache, Rate Limits, Queue Support) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=rag:development:
QUERY_CACHE_TTL_SECONDS=600
EMBEDDING_CACHE_TTL_SECONDS=604800
RERANK_CACHE_TTL_SECONDS=1800

# --- Qdrant (Vector Database) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=chunks
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=64

# --- MinIO (Self-Hosted S3-Compatible Object Storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=300

# --- Embedding & Reranker Models ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SERVICE_URL=http://embedding-service:8080
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_SERVICE_URL=http://reranker-service:8081

# --- Approved Chunking & Retrieval Defaults (Section 5.1) ---
RECURSIVE_PARENT_TARGET_TOKENS=1200
RECURSIVE_PARENT_MIN_TOKENS=1000
RECURSIVE_PARENT_MAX_TOKENS=1400
RECURSIVE_CHILD_TARGET_TOKENS=350
RECURSIVE_CHILD_MIN_TOKENS=300
RECURSIVE_CHILD_MAX_TOKENS=400
RECURSIVE_CHILD_OVERLAP_TOKENS=50
SEMANTIC_SECTION_TOKEN_THRESHOLD=2500
MAX_PARENT_CONTEXTS_PER_ANSWER=3
HYBRID_CANDIDATE_LIMIT=60
RERANKED_CHILD_LIMIT=8

# --- LLM & Generation ---
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_FALLBACK_MODEL_NAME=gpt-4o
LLM_API_KEY=replace-with-llm-api-key
LLM_TEMPERATURE=0.1
ENABLE_GROUNDING_CHECK=false

# --- LangSmith (AI Tracing & Evaluation) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace-with-langsmith-api-key
LANGCHAIN_PROJECT=enterprise-rag-platform

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000